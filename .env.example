# -----------------------------
# 🌍 Ambiente
# -----------------------------
ENV=dev
DEBUG=True
FLAG_FILE=app/config/initialized.pkl

# Documentação interactiva: /docs (Swagger), /redoc e /openapi.json.
# Por omissão segue o ENV — ligada fora de produção, desligada em produção.
# Define isto só para forçar o contrário (ex.: ambiente de staging com
# ENV=production onde ainda queres o Swagger acessível).
# ENABLE_DOCS=true

# -----------------------------
# 🗄️ Banco de Dados
# -----------------------------
DATABASE_URL=postgresql://usuario:senha@localhost:5432/meubanco
DATABASE_URL_ALEMBIC=postgresql://usuario:senha@localhost:5432/meubanco

PGUSER=postgres
PGPASSWORD=sua_senha_aqui
PGHOST=localhost
PGPORT=5432
PGDATABASE=seu_banco_de_dados
PGSSLMODE=disable

# -----------------------------
# 🔐 JWT / Segurança
# -----------------------------
# ⚠️ NUNCA reutilizes os valores deste ficheiro: ele está versionado, logo
#    qualquer valor aqui é público. Gera chaves novas por ambiente.
#
#    SECRET_KEY:     python -c "import secrets; print(secrets.token_urlsafe(64))"
#    ENCRYPTION_KEY: python -c "from app.services.crypto_utils import generate_master_key; print(generate_master_key())"

SECRET_KEY=<gerar-chave-unica-por-ambiente>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
EMAIL_VERIFICATION_EXPIRE_HOURS=24

# 🔑 Chave-mestra que cifra as credenciais das conexões guardadas na BD.
#    Tem de ser DIFERENTE da SECRET_KEY (propósitos distintos: uma assina
#    tokens, a outra cifra dados em repouso).
#
#    ⚠️ Perder esta chave torna as credenciais guardadas irrecuperáveis.
#       Guarda-a num gestor de segredos, não só no .env.
ENCRYPTION_KEY=<gerar-chave-mestra-unica-por-ambiente>

# 🛡️ Rate limiting do login (trava brute-force)
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW=300

# -----------------------------
# ⚙️ Aplicação
# -----------------------------
APP_NAME=GeradorDadosInteligente
APP_ENV=development
APP_LOCALE=pt_PT

# -----------------------------
# 🌐 CORS e Cookies
# -----------------------------
# ⚠️ Lista explícita de origens. "*" é rejeitado quando ENV=production:
#    a API autentica por cookie e os browsers proíbem wildcard com credenciais.
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=False
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=localhost
# 🔒 HttpOnly impede o JavaScript de ler os cookies de sessão (defesa contra
#    roubo de token por XSS). Mantém True em produção.
COOKIE_HTTPONLY=True

# -----------------------------
# 💾 Sistema de Cache
# -----------------------------
CACHE_ENABLED=True
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE_MB=100
CACHE_CLEANUP_INTERVAL=3600
CACHE_CLEANUP_PROBABILITY=0.01
CACHE_MAX_OLD_FILES_REMOVE=10
CACHE_DISABLE_FLAG=False
CACHE_DIR_NAME=cache
CACHE_PICKLE_PROTOCOL=4
CACHE_LOG_HITS=False
CACHE_LOG_MISSES=False

# -----------------------------
# 🧩 Cache Binário (offsets, etc.)
# -----------------------------
CACHE_BINARIO_ENABLED=True
CACHE_BINARIO_FILE=offset_cache.bin
CACHE_BINARIO_AUTO_SAVE=True
CACHE_BINARIO_SAVE_INTERVAL=60
CACHE_BINARIO_COMPRESSION=False

# -----------------------------
# 📊 Log
# -----------------------------
LOG_LEVEL=INFO
LOG_FILE=app.log
LOG_MAX_SIZE_MB=10
LOG_BACKUP_COUNT=5

# Ficheiro onde o logger da aplicação escreve (database_connector.log), lido
# por GET /logs/file. Por omissão fica na working directory do processo — que
# muda conforme quem arranca a aplicação (uvicorn, Docker, .exe). Define esta
# variável para o fixar num sítio conhecido. Aceita um ficheiro ou uma pasta.
# DATABASE_CONNECTOR_LOG_FILE=/app/logs/database_connector.log

# -----------------------------
# ⚡ Performance
# -----------------------------
MAX_WORKERS=4
BATCH_SIZE=1000
REQUEST_TIMEOUT=30

# -----------------------------
# 🤖 Faker e Gerador
# -----------------------------
FAKER_LOCALE=pt_PT
FAKER_SEED=42
GENERATOR_DEFAULT_LOCALE=pt_PT
GENERATOR_MAX_RETRIES=3
GENERATOR_UNIQUE_RETRIES=100
GENERATOR_NULL_PROBABILITY=0.05


FORCE_DB_RESET=true
# -----------------------------
# 🧪 Testes
# -----------------------------
TEST_MODE=False
TEST_SEED=123
TEST_MAX_ROWS=10000

# -----------------------------
# 🌐 API e Monitoramento
# -----------------------------
API_BASE_URL=http://localhost:8000
API_TIMEOUT=30
API_RETRY_ATTEMPTS=3
MONITORING_ENABLED=False
METRICS_PORT=9090
HEALTH_CHECK_INTERVAL=30

# -----------------------------
# 🧠 IA & LLMs
# -----------------------------
DISABLE_MODEL_SOURCE_CHECK=True

# ================================
# Gemini API
# ================================
GEMINI_API_KEY=sua_api_key_do_google_aqui
MODEL_NAME=gemini-2.5-flash
GEMINI_TEMPERATURE="0.7"
GEMINI_MAX_TOKENS="8192"
GEMINI_MAX_RETRIES="3"
GEMINI_SYSTEM_PROMPT="És um especialista em Base de dados, Ciência de dados e Engenharia de software. Responde de forma clara, prática e didática. Se não souberes, diz que não sabes."

# ================================
# DeepSeek API
# ================================
DEEPSEEK_API_KEY=sua_api_key_do_deepseek_aqui


STORAGE_BUCKET=meu-bucket
# STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ENDPOINT=http://172.16.66.123:9000
STORAGE_ACCESS_KEY=admin
STORAGE_SECRET_KEY=superpassword
STORAGE_REGION=us-east-1
STORAGE_LOCAL_PATH=./storage_cache
CACHE_PREFIX=cache_
# -----------------------------
# 🔥 Redis (cache)
# -----------------------------
# Serviço `redis` do docker-compose.yml, publicado no anfitrião na 6380.
# REDIS_USERNAME/REDIS_PASSWORD são lidos pelo compose para criar o utilizador
# ACL; o utilizador `default` fica desligado, por isso ambos são obrigatórios.
# Valores para o backend a correr no anfitrião — no contentor, o compose
# reescreve host/porta/URL para `redis:6379`.
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DB=0
REDIS_USERNAME=mustainf
REDIS_PASSWORD=troca_esta_password
REDIS_PORT_HOST=6380
REDIS_SOCKET_TIMEOUT=5
REDIS_CONNECT_TIMEOUT=5
# Ganha a todas as variáveis acima — manter coerente com elas.
app_cache_REDIS_URL=redis://mustainf:troca_esta_password@localhost:6380/0
REDIS_CACHE_PREFIX=cache:
# -----------------------------
# 🗄️ Pool de conexões da BD da aplicação
# -----------------------------
# pool_pre_ping está sempre ativo: valida a ligação antes de a usar,
# evitando 500 intermitentes por conexões fechadas pelo servidor.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30

# -----------------------------
# ✉️ SMTP (Serviço de E-mail)
# -----------------------------
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@empresa.com
SMTP_PASSWORD=sua_senha_de_app
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=notificacoes@mustainf.com
SMTP_FROM_NAME="MustaInf Notificações"
SMTP_REPLY_TO=suporte@mustainf.com
SMTP_TIMEOUT=30
SMTP_MAX_RETRIES=3

# -----------------------------
# 📱 SMPP (Serviço de SMS)
# -----------------------------
SMPP_ENABLED=false
SMPP_HOST=smsc.operadora.com
SMPP_PORT=2775
SMPP_SYSTEM_ID=seu_system_id
SMPP_PASSWORD=sua_senha_smsc
SMPP_SYSTEM_TYPE=""
SMPP_BIND_TYPE=transceiver
SMPP_SOURCE_ADDR=MustaInf
SMPP_SOURCE_TON=5
SMPP_SOURCE_NPI=0
SMPP_DEST_TON=1
SMPP_DEST_NPI=1
SMPP_DATA_CODING=0
SMPP_TIMEOUT=30
SMPP_MAX_RETRIES=3

# -----------------------------
# 🌐 Provedores OAuth2 / Social Login
# -----------------------------
# URL do Frontend para onde o usuário será redirecionado após autenticação
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# 1. Google (Console Google Cloud -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 2. GitHub (Settings -> Developer Settings -> OAuth Apps)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 3. GitLab (User Settings -> Applications ou Project Settings)
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_URL=https://gitlab.com
GITLAB_SCOPES=read_user

# 4. Microsoft / Azure AD (Azure Portal -> Entra ID -> App Registrations)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# 5. Auth0 (Opcional - caso utilize o tenant da Auth0)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_LINKEDIN_CONNECTION=linkedin
# AUTH0_LINKEDIN_REDIRECT_URI=http://localhost:8000/auth/auth0/callback

# 6. LinkedIn (Direct OAuth2 / OIDC ou via conexão Auth0)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# -----------------------------
# 📺 YouTube & Recomendador de Vídeos
# -----------------------------
# Chave da API do YouTube Data v3 (Google Cloud Console -> APIs & Services -> Credentials)
YOUTUBE_API_KEY=
# Tempo de vida do cache de buscas no Redis em segundos (padrão 1 hora = 3600)
YOUTUBE_CACHE_TTL=3600
# Consulta padrão de busca caso o usuário não informe termo (fallback)
YOUTUBE_DEFAULT_SEARCH_QUERY=technology programming
# Limite máximo de vídeos retornados por requisição na API do YouTube (1 a 50)
YOUTUBE_MAX_SEARCH_RESULTS=50
# Ativa catálogo local mock quando YOUTUBE_API_KEY não estiver configurada (True/False)
YOUTUBE_FALLBACK_CATALOG_ENABLED=True

# Validade das recomendações persistidas para cada usuário em horas (padrão 24 horas)
RECOMMENDATION_TTL_HOURS=24
# Quantidade padrão de vídeos a recomendar por usuário
RECOMMENDATION_DEFAULT_LIMIT=20
# Quantidade de itens do histórico de visualização considerados para extrair gostos
RECOMMENDATION_HISTORY_LIMIT=20
# Limite de vídeos candidatos pesquisados por tópico/canal
RECOMMENDATION_CANDIDATE_LIMIT=25
# Termos de busca de fallback para cold-start (separados por vírgula)
RECOMMENDATION_FALLBACK_QUERIES=tecnologia programação,desenvolvimento web,computação em nuvem
# Quantidade máxima de canais favoritos extraídos do histórico
RECOMMENDATION_FAVORITE_CHANNELS_LIMIT=5
# Quantidade de canais favoritos pesquisados para busca de candidatos
RECOMMENDATION_QUERY_CHANNEL_TERMS_LIMIT=2
# Quantidade mínima de recomendações em cache antes de forçar recálculo automático
RECOMMENDATION_MIN_CACHED_COUNT=5
# Limite de pontuação para considerar vídeo como 'Alta taxa de engajamento'
RECOMMENDATION_HIGH_SCORE_THRESHOLD=0.7

# Pesos do Algoritmo de Score (Soma ideal = 1.0)
# Peso atribuído ao engajamento (likes/views normalizados)
RECOMMENDATION_WEIGHT_ENGAGEMENT=0.5
# Peso atribuído à similaridade de categoria e canais favoritos
RECOMMENDATION_WEIGHT_CATEGORY=0.3
# Peso atribuído à recência (vídeos mais recentes ganham pontuação maior)
RECOMMENDATION_WEIGHT_RECENCY=0.2

# Calibragem de Similaridade de Categoria e Canal
# Pontuação quando a categoria do vídeo coincide com a preferida do usuário
RECOMMENDATION_SIMILARITY_CATEGORY_MATCH=1.0
# Pontuação quando o canal pertence aos canais favoritos do usuário
RECOMMENDATION_SIMILARITY_CHANNEL_MATCH=0.9
# Pontuação padrão para usuários novos sem histórico (cold-start)
RECOMMENDATION_SIMILARITY_COLD_START=0.6
# Pontuação de similaridade padrão para categorias não correlacionadas
RECOMMENDATION_SIMILARITY_DEFAULT=0.3

# Calibragem do Algoritmo e Recência
# Taxa de like/view considerada como engajamento máximo (100% no score de engajamento)
RECOMMENDATION_ENGAGEMENT_BENCHMARK=0.08
# Horizonte temporal em dias para cálculo da recência (padrão 365 dias)
RECOMMENDATION_RECENCY_DAYS_HORIZON=365
# Piso mínimo de pontuação de recência para vídeos antigos
RECOMMENDATION_RECENCY_MIN_FLOOR=0.1

# -----------------------------
# 🎮 Tapatan 3x3 - Configurações do Jogo & WebSocket
# -----------------------------
GAME_TURN_TIMEOUT_SECONDS=30
GAME_AI_DEFAULT_DIFFICULTY=medium
GAME_MAX_CHAT_HISTORY=100
GAME_WS_PING_INTERVAL=15
GAME_KNOWLEDGE_BASE_PATH=app/services/game_knowledge_base.json
GAME_RECONNECT_TIMEOUT_SECONDS=45
GAME_STATS_CACHE_TTL_SECONDS=60
